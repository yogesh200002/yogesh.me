{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "portfolio-website",
	"compatibility_date": "2026-06-12",
	"compatibility_flags": ["nodejs_compat_v2"],
	"routes": [
		{
			"pattern": "yogesh.me",
			"custom_domain": true,
		},
	],
	"assets": {
		"directory": "./dist",
	},
	"kv_namespaces": [
		{
			"binding": "PERSONAL_SITE_KV",
			"id": "eebe4bf1cad144c0a47b8dc0e6df6bdb",
		},
	],
	"observability": {
		"enabled": true,
	},
}
