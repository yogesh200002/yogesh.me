{
	"name": "yogesh.me",
	"type": "module",
	"version": "0.0.2",
	"packageManager": "pnpm@11.27.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "pnpm run typecheck && astro build",
		"cf-typegen": "wrangler types worker-configuration.d.ts --include-env=false",
		"typecheck": "pnpm run cf-typegen && tsc --noEmit && astro check",
		"preview": "wrangler dev --local --port 4321",
		"deploy:dry": "wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"astro": "astro"
	},
	"browser": {
		"fs": false,
		"child_process": false
	},
	"dependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/cloudflare": "^14.3.2",
		"@astrojs/mdx": "^8.0.1",
		"@astrojs/react": "^6.0.6",
		"@tailwindcss/vite": "^4.3.2",
		"astro": "^7.3.3",
		"cnfast": "^0.0.8",
		"lucide-react": "^1.23.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"tailwindcss": "^4.3.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.33.0",
		"@tailwindcss/typography": "^0.5.13",
		"@types/node": "^22.5.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"eslint": "^9.33.0",
		"eslint-plugin-astro": "^1.3.1",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^16.3.0",
		"prettier": "^3.6.2",
		"prettier-plugin-astro": "^0.14.1",
		"typescript": "^5.3.3",
		"typescript-eslint": "^8.62.1",
		"wrangler": "^4.134.0"
	}
}
